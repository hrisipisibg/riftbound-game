# Keep the repository focused on the Unity project and its documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/HANDOFF.md
!/TASKS.md
!/ASSET_REQUESTS.md
!/CHARACTER_UPDATE.md
!/PROTOTYPE.md
!/Assets/
!/Packages/
!/ProjectSettings/
!/Docs/
!/.github/

# Unity caches, local state, diagnostics and the previous VCS stay local.
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Bb]uilds/
**/[Bb]uild/
**/[Uu]ser[Ss]ettings/
**/.plastic/
**/.code-check/
**/.vs/
**/.idea/
**/.DS_Store
**/Thumbs.db
**/*.csproj
**/*.sln
**/*.slnx
**/*.user
**/*.pidb
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db
**/*.log
**/*.tmp
**/*.bak
**/*.request
**/.env
**/.env.*
**/*.keystore
**/*.jks
**/*.pfx
**/*.p12
/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/aa.meta
/Assets/Resources/PerformanceTestRun*.json
/Assets/Resources/PerformanceTestRun*.json.meta

# Adobe's vendor source assembly is named Library; it is not Unity's generated cache.
!/Assets/Adobe/Substance3DForUnity/Connector/Library/
!/Assets/Adobe/Substance3DForUnity/Connector/Library/**

# Local workspace notes
/.coordination/
/HANDOFF.md
/TASKS.md
/ASSET_REQUESTS.md
/CHARACTER_UPDATE.md
/PROTOTYPE.md

# Publish maintained documentation; keep working records local.
/Docs/*
!/Docs/Design/
!/Docs/Lore/
!/Docs/Development/
!/Docs/Integration/
!/Docs/WORLD_ZONES.md
!/Docs/ONLINE_SETUP.md
!/Docs/VALIDATION.md
!/Docs/GAMEPLAY.md
!/Docs/ROADMAP.md
!/Docs/RELEASE_PLAN.md
/Docs/Design/*
!/Docs/Design/COMBAT_REFINEMENT_PLAN.md
/Docs/Integration/*
!/Docs/Integration/Verify-CombinedRelay.ps1
!/Docs/Integration/README.md
